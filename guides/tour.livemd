# Faction: a guided tour

```elixir
Mix.install([
  {:faction, path: Path.join(__DIR__, "..")},
  # The fixture app's Ecto schemas need Ecto; Faction itself never loads it.
  {:ecto, "~> 3.12"},
  {:kino, "~> 0.19"}
])

Code.require_file(Path.join(__DIR__, "../fixtures/fixture.exs"))
```

## What Faction is

An AI agent that navigates an Elixir codebase with `grep` guesses: grep matches comments and strings, and misses imports, aliases, captures and code generated by macros. The compiler already knows the real answers.

**Faction reads the compiled BEAM files** (their debug info, never loading or compiling the project), writes one flat **JSONL file per relation**, and a `schema.sql` that loads them into **DuckDB**. The agent then answers questions like *who calls this function?* with SQL instead of guessing.

A few rules shape everything below (details in [`PRINCIPLES.md`](../PRINCIPLES.md)):

* **The compiler is the source of truth.** Source files only add line ranges.
* **Facts, not interpretation.** Anything derivable (transitive callers, dead code) is a query, never a stored column.
* **Flat relations, one identity.** A function is always `(module, function, arity)`, the same three columns everywhere, so any two relations join directly.
* **Self-describing.** Every table, view and column carries a comment in DuckDB.

This notebook needs `duckdb` on `PATH` and Elixir 1.18 or later. `mise run tour:livebook` starts Livebook with both pinned. For a non-interactive, self-checking version of this tour, run `mise run tour`.

<!-- livebook:{"break_markdown":true} -->

Helpers used below: run a query and render it as a table, show source lines, and draw diagrams.

````elixir
defmodule Tour do
  @moduledoc "Helpers for this notebook: DuckDB queries via the duckdb CLI, rendered with Kino."

  alias Faction.Fixture
  alias Faction.Relation

  @doc "Where this notebook writes Faction's output for the fixture app."
  def out, do: Path.join(System.tmp_dir!(), "faction-livebook-tour")

  @doc "Runs SQL against out_dir/faction.duckdb and renders the result as a table."
  def query(sql, out \\ out(), name \\ "Result") do
    columns = Enum.map(rows("DESCRIBE " <> String.trim(sql), out), & &1["column_name"])
    Kino.DataTable.new(rows(sql, out), keys: columns, name: name, sorting_enabled: true)
  end

  @doc "Runs SQL and returns the rows as maps."
  def rows(sql, out \\ out()) do
    case System.cmd("duckdb", ["-json", "faction.duckdb", sql], cd: out, stderr_to_stdout: true) do
      {output, 0} -> if String.trim(output) == "", do: [], else: JSON.decode!(output)
      {output, _status} -> raise "duckdb: #{output}"
    end
  end

  @doc "Loads schema.sql (and so every JSONL file) into out_dir/faction.duckdb."
  def load!(out \\ out()) do
    File.rm(Path.join(out, "faction.duckdb"))
    {_output, 0} = System.cmd("duckdb", ["faction.duckdb", "-f", "schema.sql"], cd: out, stderr_to_stdout: true)
    :ok
  end

  @doc "Fixture source lines, numbered."
  def source(path, first, last) do
    lines =
      Fixture.root()
      |> Path.join(path)
      |> File.read!()
      |> String.split("\n")
      |> Enum.slice((first - 1)..(last - 1)//1)
      |> Enum.with_index(first)
      |> Enum.map_join("\n", fn {line, number} -> String.pad_leading("#{number}", 3) <> "  " <> line end)

    Kino.Markdown.new("`#{path}`\n\n```elixir\n#{lines}\n```")
  end

  @doc "An entity-relationship diagram of the relations and views, generated from Faction.Relation."
  def er_diagram do
    tables =
      for relation <- Relation.all() do
        columns =
          Enum.map_join(relation.columns, "\n", fn {name, type, _comment} ->
            "    #{type |> String.split() |> hd()} #{name}"
          end)

        "  #{relation.name} {\n#{columns}\n  }"
      end

    views =
      for view <- Relation.views() do
        columns = Enum.map_join(view.columns, "\n", fn {name, _comment} -> "    view #{name}" end)
        "  #{view.name} {\n#{columns}\n  }"
      end

    # How the relations join: every function reference is (module, function, arity).
    joins = """
      modules ||--o{ functions : "module"
      functions ||--o{ function_calls : "caller_*"
      functions |o--o{ function_calls : "callee_* (app callees)"
      function_calls ||--o{ external_functions : "callee_* (non-app callees)"
      functions ||--o{ dynamic_function_calls : "caller_*"
      functions ||--o{ module_references : "caller_*"
      modules |o--o{ module_references : "referenced_module (app modules)"
      modules ||--o{ behaviours : "module"
      behaviours }o--o{ callbacks : "behaviour"
      callbacks ||--o{ callback_impls : "behaviour, function, arity"
      functions ||--o{ callback_impls : "module, function, arity"
      modules ||--o| ecto_schemas : "module"
      ecto_schemas ||--o{ ecto_fields : "module"
      ecto_schemas ||--o{ ecto_assocs : "module"
      ecto_schemas |o--o{ ecto_assocs : "related_module"
    """

    Kino.Mermaid.new("erDiagram\n" <> Enum.join(tables ++ views, "\n") <> "\n" <> joins)
  end

  @doc "A flowchart of caller -> callee edges; rows have caller and callee keys."
  def call_graph(edges) do
    names = edges |> Enum.flat_map(&[&1["caller"], &1["callee"]]) |> Enum.uniq()
    ids = names |> Enum.with_index() |> Map.new(fn {name, index} -> {name, "n#{index}"} end)
    nodes = Enum.map_join(names, "\n", &"  #{ids[&1]}[\"#{&1}\"]")
    arrows = Enum.map_join(edges, "\n", &"  #{ids[&1["caller"]]} --> #{ids[&1["callee"]]}")
    Kino.Mermaid.new("flowchart LR\n" <> nodes <> "\n" <> arrows)
  end

  @doc "Tabs with every .ex file of the fixture app."
  def fixture_sources do
    lib = Path.join(Fixture.root(), "lib")

    lib
    |> Path.join("**/*.ex")
    |> Path.wildcard()
    |> Enum.sort()
    |> Enum.map(fn file ->
      {Path.relative_to(file, lib), Kino.Markdown.new("```elixir\n#{File.read!(file)}\n```")}
    end)
    |> Kino.Layout.tabs()
  end

  @doc "Runs Faction on a compiled Mix app and summarises it."
  def explore_app(app) do
    app = Path.expand(app)
    [_match, name] = Regex.run(~r/\bapp:\s*:(\w+)/, File.read!(Path.join(app, "mix.exs")))
    ebin = Path.join(app, "_build/dev/lib/#{name}/ebin")
    out = Path.join(System.tmp_dir!(), "faction-livebook-#{name}")

    {micros, summary} =
      :timer.tc(fn -> Faction.run([ebin], root: app, out: out, deps: [Path.join(app, "_build/dev/lib")]) end)

    load!(out)

    Kino.Layout.grid(
      [
        Kino.Markdown.new("""
        **#{summary.beams} BEAMs** in **#{Float.round(micros / 1_000_000, 2)} s**, output in `#{out}`.
        Skipped: #{length(summary.skipped)}. Behaviours without a BEAM: #{inspect(summary.missing_behaviours)}.
        """),
        Kino.DataTable.new(Enum.map(summary.rows, fn {relation, count} -> %{relation: relation, rows: count} end),
          keys: [:relation, :rows],
          name: "Rows per relation"
        ),
        query(
          """
          SELECT c.callee_module AS module, c.callee_function AS function, c.callee_arity AS arity, count(*) AS call_sites
          FROM function_calls c JOIN functions f
            ON f.module = c.callee_module AND f.function = c.callee_function AND f.arity = c.callee_arity
          WHERE NOT f.is_generated
          GROUP BY ALL ORDER BY call_sites DESC LIMIT 15
          """,
          out,
          "Most-called application functions"
        ),
        query(
          """
          SELECT callee_module AS module, count(DISTINCT caller_module) AS calling_modules
          FROM function_calls
          WHERE callee_module IN (SELECT module FROM modules) AND callee_module <> caller_module
          GROUP BY ALL ORDER BY calling_modules DESC LIMIT 15
          """,
          out,
          "Modules with the most callers"
        )
      ],
      columns: 1
    )
  end
end

System.find_executable("duckdb") ||
  raise "duckdb is not on PATH (start Livebook with `mise run tour:livebook`)"

:ok
````

## The fixture app

Everything below runs on a tiny app that lives in `fixtures/my_app`: a Phoenix-style controller, a context, a repo, Ecto schemas, a worker implementing a behaviour, a protocol, macros, and a few deliberately tricky cases. Its dependencies (`Phoenix.Controller`, `Oban.Worker`, …) are small stand-ins in `fixtures/deps`. Browse it:

```elixir
Tour.fixture_sources()
```

## Running Faction

The notebook compiles the fixture (Faction itself never compiles anything; it only reads BEAMs), then runs Faction on the app's `ebin` directory. `deps:` points at dependency BEAMs, read only to find the callbacks of behaviours such as `Oban.Worker`.

```elixir
Faction.Fixture.compile!()

summary =
  Faction.run([Faction.Fixture.app_ebin()],
    root: Faction.Fixture.root(),
    out: Tour.out(),
    deps: [Faction.Fixture.deps_ebin()]
  )
```

The same run from a shell, with the escript (`MIX_ENV=prod mix escript.build`):

```elixir
Kino.Markdown.new("""
~~~sh
faction --root #{Faction.Fixture.root()} \\
  --out #{Tour.out()} \\
  --deps #{Faction.Fixture.deps_ebin()} \\
  #{Faction.Fixture.app_ebin()}
~~~
""")
```

It wrote one JSONL file per relation and a `schema.sql`. The JSONL is the raw output, one fact per line:

````elixir
Kino.Layout.tabs(
  for file <- ["modules.jsonl", "functions.jsonl", "function_calls.jsonl", "schema.sql"] do
    content = Tour.out() |> Path.join(file) |> File.read!() |> String.split("\n") |> Enum.take(12) |> Enum.join("\n")
    {file, Kino.Markdown.new("```\n#{content}\n…\n```")}
  end
)
````

`schema.sql` loads everything into `faction.duckdb`, typed and commented, which is what an agent queries (`duckdb faction.duckdb "SELECT …"`):

```elixir
Tour.load!()
Tour.query("SELECT table_name, estimated_size AS rows, comment FROM duckdb_tables() ORDER BY table_name", Tour.out(), "Tables")
```

## The data model

Nine relations and two derived views. Every function reference is the same triple, so everything joins on `(module, function, arity)`:

```elixir
Tour.er_diagram()
```

Each relation describes itself: the comments below are read back from DuckDB (`FROM faction_columns` lists every column), not from this notebook. Pick a tab.

```elixir
tabs =
  for name <- Enum.map(Faction.Relation.all(), & &1.name) ++ Enum.map(Faction.Relation.views(), & &1.name) do
    [%{"comment" => comment}] =
      Tour.rows("""
      SELECT comment FROM duckdb_tables() WHERE table_name = '#{name}'
      UNION ALL SELECT comment FROM duckdb_views() WHERE view_name = '#{name}'
      """)

    {to_string(name),
     Kino.Layout.grid(
       [
         Kino.Markdown.new(comment),
         Tour.query("SELECT column_name, data_type, comment FROM faction_columns WHERE table_name = '#{name}'", Tour.out(), "Columns"),
         Tour.query("SELECT * FROM #{name} LIMIT 8", Tour.out(), "Sample rows")
       ],
       columns: 1
     )}
  end

Kino.Layout.tabs(tabs)
```

Locations point at real source. `MyApp.Orders.list_orders/1` is recorded as `lib/my_app/orders.ex` lines 2–4:

```elixir
Kino.Layout.grid(
  [
    Tour.query("SELECT * FROM functions WHERE module = 'MyApp.Orders' AND function = 'list_orders'"),
    Tour.source("lib/my_app/orders.ex", 1, 7)
  ],
  columns: 2
)
```

## Questions an agent asks

Every cell below is editable: change the function names and re-run.

### Who calls `list_orders/1`?

A direct call, a capture (`&MyApp.Orders.list_orders/1`) and an `apply/3` with literal arguments all count; `kind` tells them apart.

```elixir
Tour.query("""
SELECT caller_module, caller_function, caller_arity, kind, path, line
FROM function_calls
WHERE callee_module = 'MyApp.Orders' AND callee_function = 'list_orders' AND callee_arity = 1
ORDER BY caller_module, caller_function
""")
```

### What does `OrderController.index/2` call?

`conn.assigns.user_id` is map field access, not a call, so it is not listed.

```elixir
Kino.Layout.grid(
  [
    Tour.query("""
    SELECT callee_module, callee_function, callee_arity, line
    FROM function_calls
    WHERE caller_module = 'MyAppWeb.OrderController' AND caller_function = 'index' AND caller_arity = 2
    ORDER BY line
    """),
    Tour.source("lib/my_app_web/order_controller.ex", 1, 7)
  ],
  columns: 2
)
```

### Blast radius: what could break if `query/1` changes?

Transitive callers are a query, not a stored fact: a recursive CTE over `function_calls`.

```elixir
blast_radius = """
WITH RECURSIVE up(module, function, arity) AS (
  SELECT 'MyApp.Orders', 'query', 1
  UNION
  SELECT c.caller_module, c.caller_function, c.caller_arity
  FROM function_calls c JOIN up
    ON c.callee_module = up.module AND c.callee_function = up.function AND c.callee_arity = up.arity
)
"""

edges =
  Tour.rows(blast_radius <> """
  SELECT DISTINCT
    c.caller_module || '.' || c.caller_function || '/' || c.caller_arity AS caller,
    c.callee_module || '.' || c.callee_function || '/' || c.callee_arity AS callee
  FROM function_calls c JOIN up
    ON c.callee_module = up.module AND c.callee_function = up.function AND c.callee_arity = up.arity
  """)

Kino.Layout.grid([Tour.query(blast_radius <> "SELECT * FROM up ORDER BY ALL"), Tour.call_graph(edges)], columns: 2)
```

### Which public functions does nothing call?

A candidate list, not a verdict. There is one row per source definition: default-argument arities share a `start_line`, and the shorter arity's call to the longer one does not count as use. Callback implementations and macros (whose use sites are not recorded) are excluded. Framework entry points such as controller actions (called by the router at runtime) remain.

```elixir
Tour.query("""
WITH arities AS (
  SELECT f.module, f.function, f.arity, f.path, f.start_line FROM functions f
  WHERE f.visibility = 'public' AND NOT f.is_generated AND f.function NOT LIKE 'MACRO-%'
    AND NOT EXISTS (SELECT 1 FROM callback_impls i
      WHERE i.module = f.module AND i.function = f.function AND i.arity = f.arity)),
used AS (
  SELECT DISTINCT a.module, a.function, a.start_line FROM arities a
  JOIN function_calls c ON c.callee_module = a.module AND c.callee_function = a.function AND c.callee_arity = a.arity
  WHERE NOT EXISTS (SELECT 1 FROM arities s
    WHERE s.module = c.caller_module AND s.function = c.caller_function
      AND s.arity = c.caller_arity AND s.start_line = a.start_line))
SELECT a.module, a.function, list(a.arity ORDER BY a.arity) AS arities, a.path, a.start_line
FROM arities a ANTI JOIN used u
  ON u.module = a.module AND u.function = a.function AND u.start_line IS NOT DISTINCT FROM a.start_line
GROUP BY ALL ORDER BY ALL
""")
```

### Who implements `Oban.Worker`, and what is its contract?

`callbacks` come from the behaviour's own BEAM, here a dependency. `callback_impls` is a view that joins them to `functions`.

```elixir
Tour.query("""
SELECT c.behaviour, c.function, c.arity, c.is_optional, i.module AS implemented_by
FROM callbacks c LEFT JOIN callback_impls i USING (behaviour, function, arity)
WHERE c.behaviour = 'Oban.Worker'
ORDER BY c.function
""")
```

### What does `MyApp.Orders.Order` look like in the database?

```elixir
Kino.Layout.grid(
  [
    Tour.query("""
    SELECT s.source_table, f.field, f.type, f.is_primary_key
    FROM ecto_schemas s JOIN ecto_fields f USING (module)
    WHERE module = 'MyApp.Orders.Order'
    """, Tour.out(), "Fields"),
    Tour.query("SELECT name, kind, related_module FROM ecto_assocs WHERE module = 'MyApp.Orders.Order'", Tour.out(), "Associations and embeds"),
    Tour.source("lib/my_app/orders/order.ex", 1, 14)
  ],
  columns: 1
)
```

### Where might "who calls X" be incomplete?

Calls whose module is only known at runtime (`apply(mod, :handle, args)`, `mod.handle(x)`) are listed separately, with the function name and arity when they are literals.

```elixir
Tour.query("SELECT * FROM dynamic_function_calls ORDER BY ALL")
```

### Where is a module used as a value?

A module passed as an argument, listed as a supervisor child or matched as a struct is not called, so it is not in `function_calls`. `module_references` lists every literal module in a function body that is not a call's module. Filter out the schema's own generated functions to see the hand-written uses.

```elixir
Tour.query("""
SELECT caller_module, caller_function, caller_arity, path, line FROM module_references
WHERE referenced_module = 'MyApp.Orders.Order'
  AND caller_function NOT IN ('__schema__', '__struct__', '__changeset__')
ORDER BY ALL
""")
```

### Which dependency functions does the app use?

Dependencies and the standard library are never inventoried; they only appear as callees. `external_functions` derives them.

```elixir
Tour.query("""
SELECT e.module, e.function, e.arity, count(*) AS call_sites
FROM external_functions e JOIN function_calls c
  ON c.callee_module = e.module AND c.callee_function = e.function AND c.callee_arity = e.arity
GROUP BY ALL ORDER BY call_sites DESC, e.module
""")
```

## Compiler rules behind the answers

Facts come from what the compiler produced, which is sometimes not what the source looks like. Each rule shows the source next to the rows it produces.

**Macros keep their compiled name and arity**: `defmacro square(size)` is `MACRO-square/2`. **Default arguments** compile to two arities sharing one range; the shorter one calls the longer.

```elixir
Kino.Layout.grid(
  [
    Tour.source("lib/my_app/shapes.ex", 1, 14),
    Tour.query("""
    SELECT function, arity, visibility, is_generated, start_line, end_line
    FROM functions WHERE module = 'MyApp.Shapes' AND (function LIKE 'MACRO-%' OR function = 'area')
    """)
  ],
  columns: 2
)
```

**Functions injected by `use`** are generated and located at the `use` line. Code from `quote location: :keep` is located where the quote is written, here `lib/my_app_web.ex`.

```elixir
Kino.Layout.grid(
  [
    Tour.source("lib/my_app_web.ex", 1, 13),
    Tour.query("""
    SELECT 'function controller?/0' AS what, path, start_line AS line FROM functions
    WHERE module = 'MyAppWeb.OrderController' AND function = 'controller?'
    UNION ALL
    SELECT 'its call to ' || callee_module || '.' || callee_function, path, line FROM function_calls
    WHERE caller_module = 'MyAppWeb.OrderController' AND caller_function = 'controller?'
    """)
  ],
  columns: 2
)
```

**`@before_compile` clauses** don't stretch a declared function's range, and **`defoverridable`** renames the original, so `super(...)` is a call to `greet (overridable 1)`.

```elixir
Kino.Layout.grid(
  [
    Tour.source("lib/my_app/handler.ex", 1, 12),
    Tour.query("""
    SELECT function, arity, is_generated, start_line, end_line FROM functions
    WHERE module = 'MyApp.Handler' AND function IN ('handle', 'greet', 'greet (overridable 1)')
    """),
    Tour.query("SELECT caller_function, callee_function, line FROM function_calls WHERE caller_module = 'MyApp.Handler'")
  ],
  columns: 1
)
```

**A module a dependency defines on the app's behalf** (like `NimbleCSV.define/2`) is generated and has no location: its source is the dependency's, never reported as application code. **Protocols are behaviours**: a `defimpl` declares its protocol.

```elixir
Kino.Layout.grid(
  [
    Tour.query("SELECT * FROM modules WHERE module IN ('MyApp.Csv', 'MyApp.Describable.MyApp.Shapes')"),
    Tour.query("SELECT * FROM behaviours WHERE behaviour = 'MyApp.Describable'")
  ],
  columns: 1
)
```

**Operators and guards compile to Erlang calls**, and Elixir inlines some stdlib calls (`Map.to_list/1` is recorded as `maps.to_list/1`). Calls to application functions are never rewritten.

```elixir
Kino.Layout.grid(
  [
    Tour.source("lib/my_app/dispatch.ex", 14, 14),
    Tour.query("SELECT callee_module, callee_function, callee_arity FROM function_calls WHERE caller_module = 'MyApp.Dispatch' AND caller_function = 'local'")
  ],
  columns: 2
)
```

## Your own app

Point Faction at a compiled Mix app (run `mix compile` in it first). It reads `APP/_build/dev/lib/<app>/ebin`, with `APP/_build/dev/lib` as dependencies.

```elixir
form = Kino.Control.form([app: Kino.Input.text("Absolute path to a compiled Mix app")], submit: "Run Faction")
frame = Kino.Frame.new()

Kino.listen(form, fn %{data: %{app: app}} ->
  Kino.Frame.render(frame, Kino.Markdown.new("Running Faction on `#{app}`…"))

  result =
    try do
      Tour.explore_app(app)
    rescue
      error -> Kino.Markdown.new("**Failed:** `#{Exception.message(error)}`")
    end

  Kino.Frame.render(frame, result)
end)

Kino.Layout.grid([form, frame], columns: 1)
```

## Playground

Any SQL against the fixture's `faction.duckdb`. Try `DESCRIBE functions`, or ask your own question.

```elixir
sql =
  Kino.Input.textarea("SQL",
    default: """
    SELECT callee_module, count(*) AS calls
    FROM function_calls
    GROUP BY ALL ORDER BY calls DESC
    """
  )

run = Kino.Control.button("Run")
results = Kino.Frame.new()

Kino.listen(run, fn _event ->
  result =
    try do
      Tour.query(Kino.Input.read(sql))
    rescue
      error -> Kino.Markdown.new("**Error:** `#{Exception.message(error)}`")
    end

  Kino.Frame.render(results, result)
end)

Kino.Layout.grid([sql, run, results], columns: 1)
```
